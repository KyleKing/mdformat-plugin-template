// Version literals this template pins in files it owns, checked by doneram.
// The weekly Freshness workflow patches these and opens a draft PR.
//
// This config covers the root workflows and the pins inside
// package_template/, whose renders reach generated plugins through a
// copier update. .ctt/ renders carry the same literals and update with the
// next sync, so they get no sites of their own.

amends "package://github.com/kyleking/doneram/releases/download/v0.6.0/doneram@0.6.0#/Config.pkl"
import "package://github.com/kyleking/doneram/releases/download/v0.6.0/doneram@0.6.0#/Config.pkl"

local freshnessYml = ".github/workflows/freshness.yml"
local bumpYml = ".github/workflows/bump_version.yml"
local pkgFreshnessYml = "package_template/.github/workflows/freshness.yml"
local pkgTestsYml = "package_template/.github/workflows/tests.yml.jinja"

/// A `uses: owner/repo@<sha> # <tag>` GitHub Action pin, one capture group
/// spanning the sha and the tag together, since github-action patches both
/// as a single resolved value.
local function actionPin(action: String): Config.Site = new {
  file = freshnessYml
  pattern = #"\#(action)@([0-9a-f]{40} # v[\d.]+)"#
}

tools = new {
  ["checkout"] = new {
    resolver = "github-action"
    resolverName = "actions/checkout"
    sites = new {
      actionPin("actions/checkout")
      new Config.Site { file = bumpYml; pattern = #"actions/checkout@([0-9a-f]{40} # v[\d.]+|v[\d.]+)"# }
      new Config.Site { file = pkgFreshnessYml; pattern = #"actions/checkout@([0-9a-f]{40} # v[\d.]+)"# }
      new Config.Site { file = pkgTestsYml; pattern = #"actions/checkout@([0-9a-f]{40} # v[\d.]+|v[\d.]+)"# }
    }
  }
  ["commitizen-action"] = new {
    resolver = "github-branch"
    resolverName = "commitizen-tools/commitizen-action@master"
    sites = new { new Config.Site { file = bumpYml; pattern = #"commitizen-tools/commitizen-action@([0-9a-f]{40} # master|[0-9a-f]{40}|master)"# } }
  }
  ["create-github-app-token"] = new {
    resolver = "github-action"
    resolverName = "actions/create-github-app-token"
    sites = new {
      actionPin("actions/create-github-app-token")
      new Config.Site { file = pkgFreshnessYml; pattern = #"actions/create-github-app-token@([0-9a-f]{40} # v[\d.]+)"# }
    }
  }
  ["create-pull-request"] = new {
    resolver = "github-action"
    resolverName = "peter-evans/create-pull-request"
    sites = new {
      actionPin("peter-evans/create-pull-request")
      new Config.Site { file = pkgFreshnessYml; pattern = #"peter-evans/create-pull-request@([0-9a-f]{40} # v[\d.]+)"# }
    }
  }
  ["doneram"] = new {
    resolver = "github-action"
    resolverName = "kyleking/doneram"
    sites = new {
      actionPin("kyleking/doneram")
      new Config.Site { file = pkgFreshnessYml; pattern = #"kyleking/doneram@([0-9a-f]{40} # v[\d.]+)"# }
    }
  }
  ["doneram-schema"] = new {
    resolver = "github-release"
    resolverName = "kyleking/doneram"
    sites = new {
      new Config.Site { file = ".doneram.pkl"; pattern = #"releases/download/v([\d.]+)/doneram"# }
      new Config.Site { file = ".doneram.pkl"; pattern = #"doneram@([\d.]+)#/Config\.pkl"# }
    }
  }
  ["doneram-version"] = new {
    resolver = "github-release"
    resolverName = "kyleking/doneram"
    sites = new {
      new Config.Site { file = freshnessYml; pattern = #"version: v([\d.]+)"# }
      new Config.Site { file = pkgFreshnessYml; pattern = #"version: v([\d.]+)"# }
    }
  }
  ["gh-action-pypi-publish"] = new {
    resolver = "github-branch"
    resolverName = "pypa/gh-action-pypi-publish@release/v1"
    sites = new { new Config.Site { file = pkgTestsYml; pattern = #"pypa/gh-action-pypi-publish@([0-9a-f]{40} # release/v1|[0-9a-f]{40}|release/v1)"# } }
  }
  ["action-gh-release"] = new {
    resolver = "github-action"
    resolverName = "softprops/action-gh-release"
    sites = new {
      new Config.Site { file = bumpYml; pattern = #"softprops/action-gh-release@([0-9a-f]{40} # v[\d.]+|v[\d.]+)"# }
      new Config.Site { file = pkgTestsYml; pattern = #"softprops/action-gh-release@([0-9a-f]{40} # v[\d.]+|v[\d.]+)"# }
    }
  }
  ["prek-action"] = new {
    resolver = "github-action"
    resolverName = "j178/prek-action"
    sites = new { new Config.Site { file = pkgTestsYml; pattern = #"j178/prek-action@([0-9a-f]{40} # v[\d.]+|v[\d.]+)"# } }
  }
  ["setup-python"] = new {
    resolver = "github-action"
    resolverName = "actions/setup-python"
    sites = new { new Config.Site { file = pkgTestsYml; pattern = #"actions/setup-python@([0-9a-f]{40} # v[\d.]+|v[\d.]+)"# } }
  }
  ["setup-uv"] = new {
    resolver = "github-action"
    resolverName = "astral-sh/setup-uv"
    sites = new { new Config.Site { file = pkgTestsYml; pattern = #"astral-sh/setup-uv@([0-9a-f]{40} # v[\d.]+|v[\d.]+)"# } }
  }
}
