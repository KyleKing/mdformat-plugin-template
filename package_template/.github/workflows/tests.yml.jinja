---
name: CI

"on":
  push:
    branches: [main]
    tags: [v*]
  pull_request: null

jobs:
  prek:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Set up Python
        uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: 3.14
      - uses: j178/prek-action@7b101f8338a08d2bd6fdb3625e4e7692428763a3 # v3.1.1

  tests:
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      matrix:
        python-version: ["3.10", "3.14"]
        os: [ubuntu-latest, windows-latest]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Install uv and Python
        uses: astral-sh/setup-uv@1db35dd8eee11c5894872e0b383ae6c406cf738d # v10.4.0
        with:
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}
          activate-environment: true
      - name: Install Package
        run: uv pip install ".[test]"
      - name: Run pytest
        run: pytest --cov

  prek-hook:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Install uv and Python
        uses: astral-sh/setup-uv@1db35dd8eee11c5894872e0b383ae6c406cf738d # v10.4.0
        with:
          python-version: 3.14
          activate-environment: true
      - name: Install prek
        uses: j178/prek-action@7b101f8338a08d2bd6fdb3625e4e7692428763a3 # v3.1.1
        with:
          install-only: true
      - name: Install Package
        run: uv pip install ".[test]"
      - name: run prek with plugin
        run: prek run --config .pre-commit-test.yaml --all-files --verbose --show-diff-on-failure

  publish:
    name: Publish to PyPi
    needs: [prek, tests, prek-hook]
    if: github.event_name == 'push' && startsWith(github.event.ref, 'refs/tags')
    runs-on: ubuntu-latest
    environment:
      name: pypi
      url: https://pypi.org/p/{{ package_name_kebab }}
    permissions:
      contents: write  # For GitHub release creation
      id-token: write  # IMPORTANT: mandatory for PyPI trusted publishing
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          fetch-tags: true
      - name: Install uv and Python
        uses: astral-sh/setup-uv@1db35dd8eee11c5894872e0b383ae6c406cf738d # v10.4.0
        with:
          python-version: 3.14
      - name: Build Package
        run: uv build
      - name: Publish to PyPI
        uses: pypa/gh-action-pypi-publish@7245906fb61fa33a13554f9d5fb856fe61758086
      - name: Generate changelog with commitizen
        id: changelog
        run: |
          uv tool install commitizen
          VERSION="${GITHUB_REF_NAME#v}"
          CHANGELOG=$(cz changelog "$VERSION" --dry-run)
          PREV_TAG=$(git describe --tags --abbrev=0 "$GITHUB_REF^" 2>/dev/null || echo "")
          {
            echo 'body<<EOF'
            echo "$CHANGELOG"
            if [ -n "$PREV_TAG" ]; then
              echo ""
              echo "**Full Changelog**: https://github.com/{% raw %}${{ github.repository }}{% endraw %}/compare/${PREV_TAG}...${GITHUB_REF_NAME}"
            fi
            echo EOF
          } >> "$GITHUB_OUTPUT"
      - name: Generate GitHub Release Notes
        uses: softprops/action-gh-release@8a0cd651e5b2365bd640854a3fa5dfc70e4875f3 # v3.0.4
        with:
          body: {% raw %}${{ steps.changelog.outputs.body }}{% endraw %}
